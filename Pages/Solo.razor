@page "/solo"
@inject IJSRuntime JS
@inject HttpClient Http

<PageTitle>Šibenice – slovní hra</PageTitle>

<div class="game">
    <header class="top">
        <a class="back" href="./">← Menu</a>
        <h1>Šibenice</h1>
        <div class="stats">
            <span title="Skóre">⭐ @_score</span>
            <span title="Série výher">🔥 @_streak</span>
            <span title="Rekord">🏆 @_best</span>
        </div>
        <div class="toggles">
            <button class="toggle @(_sound ? "on" : "off")" @onclick="ToggleSound" aria-label="Zvuk" aria-pressed="@_sound">@(_sound ? "🔊" : "🔇")</button>
            <button class="toggle @(_vibration ? "on" : "off")" @onclick="ToggleVibration" aria-label="Vibrace" aria-pressed="@_vibration">📳</button>
        </div>
    </header>

    <nav class="chips" aria-label="Kategorie">
        @foreach (var cat in _categories)
        {
            <button class="chip @(cat == _selected ? "active" : "")" @onclick="() => RequestCategoryChange(cat)">@cat</button>
        }
    </nav>

    <nav class="chips" aria-label="Obtížnost">
        @foreach (var item in DifficultyOptions)
        {
            <button class="chip @(_difficulty == item.Value ? "active" : "")" @onclick="() => RequestDifficultyChange(item.Value)">@item.Label</button>
        }
    </nav>

    <section class="stage">
        <svg viewBox="0 0 200 220" class="gallows" role="img" aria-label="Šibenice, chyb @_wrong z @MaxWrong">
            @if (_wrong >= 1) { <line x1="20" y1="205" x2="120" y2="205" /> }
            @if (_wrong >= 2) { <line x1="50" y1="205" x2="50" y2="20" /> }
            @if (_wrong >= 3)
            {
                <line x1="50" y1="20" x2="140" y2="20" />
                <line x1="140" y1="20" x2="140" y2="45" />
            }
            @if (_wrong >= 4) { <circle cx="140" cy="62" r="17" /> }
            @if (_wrong >= 5) { <line x1="140" y1="79" x2="140" y2="135" /> }
            @if (_wrong >= 6)
            {
                <line x1="140" y1="95" x2="118" y2="120" />
                <line x1="140" y1="95" x2="162" y2="120" />
            }
            @if (_wrong >= 7)
            {
                <line x1="140" y1="135" x2="120" y2="172" />
                <line x1="140" y1="135" x2="160" y2="172" />
            }
        </svg>
        <div class="lives" aria-hidden="true">
            @for (var i = 0; i < MaxWrong; i++)
            {
                <span class="@(i < MaxWrong - _wrong ? "alive" : "dead")">●</span>
            }
        </div>
    </section>

    <p class="category">@_wordCategory</p>

    <div class="word" aria-live="polite">
        @foreach (var c in _word)
        {
            if (c == ' ')
            {
                <span class="gap"></span>
            }
            else
            {
                var shown = IsRevealed(c) || Lost;
                <span class="letter @(Lost && !IsRevealed(c) ? "missed" : "")">@(shown ? c.ToString() : "")</span>
            }
        }
    </div>

    <div class="keyboard">
        @foreach (var k in Alphabet)
        {
            var key = k;
            var used = _guessed.Contains(key);
            var good = used && _word.Any(w => WordBank.Normalize(w) == key);
            <button class="key @(used ? (good ? "good" : "bad") : "")"
                    disabled="@(used || Won || Lost)"
                    @onclick="() => Guess(key)">@key</button>
        }
    </div>

    <div class="actions">
        <button class="secondary" @onclick="UseHint" disabled="@(Won || Lost || _wrong >= MaxWrong - 1)">💡 Nápověda (−1 život)</button>
        <button class="secondary" @onclick="RequestNewRound">⏭ Přeskočit</button>
    </div>

    @if (Won || Lost)
    {
        <div class="overlay">
            <div class="dialog @(Won ? "win" : "lose")">
                <h2>@(Won ? "Vyhráno! 🎉" : "Prohra 😕")</h2>
                <p>Slovo bylo: <strong>@_word</strong></p>
                @if (Won)
                {
                    <p>+@_lastGain bodů</p>
                }
                <button @onclick="StartNextRound">Další slovo</button>
            </div>
        </div>
    }

    @if (_showResumePrompt)
    {
        <div class="overlay">
            <div class="dialog">
                <h2>Rozehraná hra</h2>
                <p>Máš tu uloženou nedokončenou hru. Chceš pokračovat tam, kde jsi skončil?</p>
                <button @onclick="ResumeSavedRound">Pokračovat</button>
                <button class="secondary" @onclick="DiscardSavedRound">Nová hra</button>
            </div>
        </div>
    }

    @if (_showDiscardConfirmation)
    {
        <div class="overlay">
            <div class="dialog">
                <h2>@DiscardTitle</h2>
                <p>@DiscardMessage</p>
                <button @onclick="ConfirmDiscard">@DiscardButtonLabel</button>
                <button class="secondary" @onclick="CancelDiscard">Pokračovat v kole</button>
            </div>
        </div>
    }
</div>

@code {
    private const int MaxWrong = 7;
    private static readonly char[] Alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".ToCharArray();

    private List<string> _categories = [WordBank.AllCategories];
    private static readonly (string Label, int? Value)[] DifficultyOptions =
        [("Vše", null), ("🟢 Lehká", 1), ("🟡 Střední", 2), ("🔴 Těžká", 3)];
    private int? _difficulty;
    private readonly HashSet<char> _guessed = [];
    private readonly Random _rng = new();

    private string _selected = WordBank.AllCategories;
    private string _word = "";
    private string _wordCategory = "";
    private int _wrong;
    private int _score;
    private int _streak;
    private int _best;
    private int _lastGain;
    private bool _scored;
    private bool _sound = true;
    private bool _vibration = true;
    private bool _showResumePrompt;
    private bool _showDiscardConfirmation;
    private SoloSave? _pendingSave;
    private string? _pendingCategory;
    private int? _pendingDifficulty;
    private string _pendingChange = "new";

    private bool Won => _word.Length > 0 && _word.Where(char.IsLetter).All(IsRevealed);
    private bool Lost => _wrong >= MaxWrong;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await WordBank.LoadAsync(Http);
            _categories = [WordBank.AllCategories, .. WordBank.Words.Keys];
        }
        catch (Exception ex)
        {
            _wordCategory = "Chyba načítání slovníku: " + ex.Message;
        }
        try
        {
            _best = await JS.InvokeAsync<int>("hra.getBest");
            _sound = await JS.InvokeAsync<bool>("fx.getSound");
            _vibration = await JS.InvokeAsync<bool>("fx.getVibration");
        }
        catch { /* localStorage nedostupné */ }
        try
        {
            _pendingSave = await JS.InvokeAsync<SoloSave?>("hra.getSoloState");
        }
        catch { _pendingSave = null; }

        if (IsValidSave(_pendingSave))
        {
            _showResumePrompt = true;
        }
        else
        {
            await JS.InvokeVoidAsync("hra.clearSoloState");
            await StartNewRound();
        }
    }

    private async Task Fx(string name)
    {
        try { await JS.InvokeVoidAsync("fx.play", name); } catch { }
    }

    private async Task ToggleSound()
    {
        _sound = !_sound;
        try { await JS.InvokeVoidAsync("fx.setSound", _sound); } catch { }
        await Fx("tap");
    }

    private async Task ToggleVibration()
    {
        _vibration = !_vibration;
        try { await JS.InvokeVoidAsync("fx.setVibration", _vibration); } catch { }
        await Fx("tap");
    }

    private bool IsRevealed(char c) => _guessed.Contains(WordBank.Normalize(c));

    private async Task RequestCategoryChange(string cat)
    {
        if (cat == _selected) return;
        _pendingCategory = cat;
        _pendingChange = "category";
        if (HasActiveRound) _showDiscardConfirmation = true;
        else await ApplyPendingChange();
    }

    private async Task RequestDifficultyChange(int? difficulty)
    {
        if (difficulty == _difficulty) return;
        _pendingDifficulty = difficulty;
        _pendingChange = "difficulty";
        if (HasActiveRound) _showDiscardConfirmation = true;
        else await ApplyPendingChange();
    }

    private bool HasActiveRound => _word.Length > 0 && !Won && !Lost;
    private string DiscardTitle => _pendingChange switch
    {
        "category" => "Změnit kategorii?",
        "difficulty" => "Změnit obtížnost?",
        _ => "Přeskočit toto slovo?"
    };
    private string DiscardMessage => _pendingChange switch
    {
        "category" => $"Rozehrané slovo bude zahozeno a začne nové kolo v kategorii {_pendingCategory}.",
        "difficulty" => "Rozehrané slovo bude zahozeno a začne nové kolo s vybranou obtížností.",
        _ => "Rozehrané slovo a dosavadní postup v tomto kole budou zahozeny."
    };
    private string DiscardButtonLabel => _pendingChange switch
    {
        "category" => "Ano, změnit kategorii",
        "difficulty" => "Ano, změnit obtížnost",
        _ => "Ano, přeskočit"
    };

    private async Task RequestNewRound()
    {
        _pendingChange = "new";
        if (HasActiveRound) _showDiscardConfirmation = true;
        else await StartNewRound();
    }

    private void CancelDiscard()
    {
        _showDiscardConfirmation = false;
        _pendingChange = "new";
        _pendingCategory = null;
        _pendingDifficulty = null;
    }

    private async Task ConfirmDiscard()
    {
        _showDiscardConfirmation = false;
        await ApplyPendingChange();
    }

    private async Task ApplyPendingChange()
    {
        if (_pendingChange == "category" && _pendingCategory is not null)
            _selected = _pendingCategory;
        else if (_pendingChange == "difficulty")
            _difficulty = _pendingDifficulty;

        _pendingCategory = null;
        _pendingDifficulty = null;
        _pendingChange = "new";
        await StartNewRound();
    }

    private Task StartNextRound() => StartNewRound();

    private async Task StartNewRound()
    {
        if (Lost || (!Won && _word.Length > 0 && !_scored))
            _streak = 0; // přeskočení nebo prohra přeruší sérii

        var pool = WordBank.Pick(_selected, _difficulty).Where(p => p.Word != _word).ToList();
        if (pool.Count == 0) pool = WordBank.Pick(_selected, _difficulty).ToList();
        if (pool.Count == 0) return;
        var pick = pool[_rng.Next(pool.Count)];
        _word = pick.Word;
        _wordCategory = pick.Category;
        _guessed.Clear();
        _wrong = 0;
        _scored = false;
        _lastGain = 0;
        await PersistRoundAsync();
    }

    private async Task ResumeSavedRound()
    {
        if (!IsValidSave(_pendingSave))
        {
            _showResumePrompt = false;
            await StartNewRound();
            return;
        }

        var save = _pendingSave!;
        _selected = save.SelectedCategory;
        _difficulty = save.Difficulty;
        _word = save.Word;
        _wordCategory = save.WordCategory;
        _guessed.Clear();
        foreach (var letter in save.Guessed) _guessed.Add(letter);
        _wrong = save.Wrong;
        _score = save.Score;
        _streak = save.Streak;
        _lastGain = save.LastGain;
        _scored = false;
        _showResumePrompt = false;
        _pendingSave = null;
        await PersistRoundAsync();
    }

    private async Task DiscardSavedRound()
    {
        _showResumePrompt = false;
        var save = _pendingSave;
        _pendingSave = null;
        if (save is not null)
        {
            _selected = save.SelectedCategory;
            _difficulty = save.Difficulty;
            _score = save.Score;
            _streak = 0; // opuštěné kolo přeruší sérii
        }
        try { await JS.InvokeVoidAsync("hra.clearSoloState"); } catch { }
        await StartNewRound();
    }

    private bool IsValidSave(SoloSave? save) =>
        save is not null && !string.IsNullOrWhiteSpace(save.Word) &&
        !string.IsNullOrWhiteSpace(save.SelectedCategory) &&
        save.Wrong >= 0 && save.Wrong < MaxWrong &&
        (save.Difficulty is null || save.Difficulty is >= 1 and <= 3) &&
        _categories.Contains(save.SelectedCategory) &&
        save.Guessed is not null &&
        !save.Word.Where(char.IsLetter).All(c => save.Guessed.Contains(WordBank.Normalize(c)));

    private async Task PersistRoundAsync()
    {
        if (!HasActiveRound)
        {
            try { await JS.InvokeVoidAsync("hra.clearSoloState"); } catch { }
            return;
        }

        var save = new SoloSave(_word, _wordCategory, _selected, _difficulty,
            _guessed.ToArray(), _wrong, _score, _streak, _lastGain);
        try { await JS.InvokeVoidAsync("hra.setSoloState", save); } catch { }
    }

    private async Task Guess(char key, bool viaHint = false)
    {
        if (Won || Lost || !_guessed.Add(key)) return;

        var correct = _word.Any(w => WordBank.Normalize(w) == key);
        if (!correct)
        {
            _wrong++;
        }

        if (Won && !_scored)
        {
            _scored = true;
            _streak++;
            _lastGain = 10 + (MaxWrong - _wrong) * 2 + _streak;
            _score += _lastGain;
            if (_score > _best)
            {
                _best = _score;
                try { await JS.InvokeVoidAsync("hra.setBest", _best); } catch { }
            }
            await Fx("win");
        }
        else if (Lost)
        {
            _scored = true;
            _streak = 0;
            _score = 0;
            await Fx("lose");
        }
        else
        {
            await Fx(viaHint ? "hint" : correct ? "ok" : "bad");
        }

        await PersistRoundAsync();
    }

    private async Task UseHint()
    {
        var hidden = _word
            .Where(char.IsLetter)
            .Select(WordBank.Normalize)
            .Distinct()
            .Where(c => !_guessed.Contains(c))
            .ToList();

        if (hidden.Count <= 1 || _wrong >= MaxWrong - 1) return;

        _wrong++;
        await Guess(hidden[_rng.Next(hidden.Count)], viaHint: true);
    }
    private sealed record SoloSave(
        string Word,
        string WordCategory,
        string SelectedCategory,
        int? Difficulty,
        char[] Guessed,
        int Wrong,
        int Score,
        int Streak,
        int LastGain);
}
